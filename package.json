{
	"name": "LaTeX-Editor",
	"version": "0.1.0",
	"description": "A self-hosted, open-source LaTeX editor built with TypeScript.",
	"main": "src/server/index.ts",
	"repository": "https://github.com/caetanoag/LaTeX-Editor.git",
	"author": "Caetano G.",
	"license": "MIT",
	"scripts": {
		"build:client": "bun build ./src/client/main.ts --outfile ./public/bundle.js --target browser",
		"dev": "bun --watch src/server/index.ts",
		"start": "bun run src/server/index.ts"
	},
	"dependencies": {
		"@types/bun": "^1.4.2",
		"@types/express": "^5.0.6",
		"express": "^5.2.1"
	}
}
