{
	"name": "LaTeX-Editor",
	"version": "0.1.0",
	"description": "A self-hosted, open-source LaTeX editor built with TypeScript.",
	"main": "src/server/server.ts",
	"repository": "https://github.com/caetanoag/LaTeX-Editor.git",
	"author": "Caetano G.",
	"license": "AGPL-3.0-only",
	"scripts": {
		"build:client": "bun build ./src/client/main.ts --outfile ./public/bundle.js --target browser",
		"dev": "bun --watch src/server/server.ts",
		"start": "bun run src/server/server.ts"
	},
	"dependencies": {
		"express": "^5.2.1",
		"pg": "^8.23.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/bun": "^1.4.3",
		"@types/express": "^5.0.6",
		"@types/pg": "^8.23.1"
	}
}
