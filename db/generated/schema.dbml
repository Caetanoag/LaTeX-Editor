Table "users" {
  "id" bigserial [pk, increment]
  "username" citext [unique, not null]
  "email" citext [unique, not null]
  "password_hash" text [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "last_login_at" timestamptz
  "updated_at" timestamptz [not null, default: `now()`]
  "deleted_at" timestamptz
}

Table "user_profiles" {
  "user_id" bigint [pk]
  "display_name" varchar(100) [not null]
  "bio" text
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
}

Table "permissions" {
  "id" serial [pk, increment]
  "code" varchar(100) [unique, not null]
  "description" text
}

Table "roles" {
  "id" serial [pk, increment]
  "scope" varchar(20) [not null]
  "name" varchar(50) [not null]
  "description" text

  Indexes {
    (scope, name) [unique]
  }
}

Table "role_permissions" {
  "role_id" int [not null]
  "permission_id" int [not null]

  Indexes {
    (role_id, permission_id) [pk]
  }
}

Table "workspaces" {
  "id" bigserial [pk, increment]
  "name" varchar(100) [not null]
  "url_identifier" citext [unique, not null]
  "description" text
  "owner_id" bigint [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "deleted_at" timestamptz
}

Table "workspace_invitations" {
  "id" bigserial [pk, increment]
  "workspace_id" bigint [not null]
  "email" citext [not null]
  "role_id" int [not null]
  "invited_by" bigint [not null]
  "token" text [unique, not null]
  "expires_at" timestamptz [not null]
  "accepted_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
}

Table "workspace_members" {
  "workspace_id" bigint [not null]
  "user_id" bigint [not null]
  "role_id" int [not null]
  "joined_at" timestamptz [not null, default: `now()`]
  "invited_by" bigint

  Indexes {
    (workspace_id, user_id) [pk]
  }
}

Table "projects" {
  "id" bigserial [pk, increment]
  "workspace_id" bigint [not null]
  "owner_id" bigint [not null]
  "title" varchar(200) [not null]
  "description" text
  "visibility" varchar(20) [not null, default: 'private']
  "forked_from_id" bigint
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "archived_at" timestamptz
}

Table "project_members" {
  "project_id" bigint [not null]
  "user_id" bigint [not null]
  "role_id" int [not null]
  "granted_by" bigint
  "granted_at" timestamptz [not null, default: `now()`]
  "expires_at" timestamptz

  Indexes {
    (project_id, user_id) [pk]
  }
}

Table "project_files" {
  "id" bigserial [pk, increment]
  "project_id" bigint [not null]
  "file_path" text [not null]
  "file_content" text [not null, default: '']
  "is_main" boolean [not null, default: false]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Indexes {
    (project_id, file_path) [unique]
    project_id [unique, name: "project_files_one_main_idx"]
  }
}

Table "file_versions" {
  "id" bigserial [pk, increment]
  "file_id" bigint [not null]
  "version_hash" text [not null]
  "message" text
  "content" text [not null, default: '']
  "author_id" bigint [not null]
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    (file_id, version_hash) [unique]
  }
}

Table "comments" {
  "id" bigserial [pk, increment]
  "project_id" bigint [not null]
  "file_id" bigint
  "created_by" bigint [not null]
  "resolved_by" bigint
  "content" text [not null, default: '']
  "parent_id" bigint
  "line_number" int
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "resolved_at" timestamptz
}

Ref:"users"."id" < "user_profiles"."user_id" [delete: cascade]

Ref:"roles"."id" < "role_permissions"."role_id" [delete: cascade]

Ref:"permissions"."id" < "role_permissions"."permission_id" [delete: cascade]

Ref:"users"."id" < "workspaces"."owner_id"

Ref:"workspaces"."id" < "workspace_invitations"."workspace_id" [delete: cascade]

Ref:"roles"."id" < "workspace_invitations"."role_id"

Ref:"users"."id" < "workspace_invitations"."invited_by"

Ref:"workspaces"."id" < "workspace_members"."workspace_id" [delete: cascade]

Ref:"users"."id" < "workspace_members"."user_id" [delete: cascade]

Ref:"roles"."id" < "workspace_members"."role_id"

Ref:"users"."id" < "workspace_members"."invited_by"

Ref:"workspaces"."id" < "projects"."workspace_id" [delete: cascade]

Ref:"users"."id" < "projects"."owner_id"

Ref:"projects"."id" < "projects"."forked_from_id" [delete: set null]

Ref:"projects"."id" < "project_members"."project_id" [delete: cascade]

Ref:"users"."id" < "project_members"."user_id" [delete: cascade]

Ref:"roles"."id" < "project_members"."role_id"

Ref:"users"."id" < "project_members"."granted_by"

Ref:"projects"."id" < "project_files"."project_id" [delete: cascade]

Ref:"project_files"."id" < "file_versions"."file_id" [delete: cascade]

Ref:"users"."id" < "file_versions"."author_id"

Ref:"projects"."id" < "comments"."project_id" [delete: cascade]

Ref:"project_files"."id" < "comments"."file_id" [delete: cascade]

Ref:"users"."id" < "comments"."created_by"

Ref:"users"."id" < "comments"."resolved_by"

Ref:"comments"."id" < "comments"."parent_id" [delete: cascade]
